generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  HR
  Employee
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
}

enum AttendanceStatus {
  Present
  Absent
  HalfDay
}

enum EmployeeStatus {
  Active
  Inactive
  Terminated
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum ReviewStatus {
  DRAFT
  COMPLETED
}

enum ComponentType {
  BONUS
  INCENTIVE
  DEDUCTION
  ALLOWANCE
}

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum CandidateStatus {
  NEW
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InterviewType {
  PHONE
  VIDEO
  IN_PERSON
  TECHNICAL
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  password             String
  role                 Role           @default(Employee)
  mustChangePassword   Boolean        @default(false)
  passwordHistory      String         @default("[]")
  twoFactorSecret      String?
  twoFactorEnabled     Boolean        @default(false)
  twoFactorVerifiedAt  DateTime?
  twoFactorBackupCodes String         @default("[]")
  employeeId           String?        @unique
  employee             Employee?      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewedLeaves       LeaveRequest[]
  notifications        Notification[]
  refreshTokens        RefreshToken[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Employee {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  phone            String?
  departmentId     String?
  position         String
  hireDate         DateTime
  birthDate        DateTime?
  salary           Float
  status           EmployeeStatus      @default(Active)
  reportsToId      String?
  shiftId          String?
  department       Department?         @relation(fields: [departmentId], references: [id])
  manager          Employee?           @relation("OrgChart", fields: [reportsToId], references: [id])
  directReports    Employee[]          @relation("OrgChart")
  shift            Shift?              @relation(fields: [shiftId], references: [id])
  user             User?
  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  documents        EmployeeDocument[]
  salaryStructures SalaryStructure[]
  salaryComponents SalaryComponent[]
  payrollRecords   PayrollRecord[]
reviewsRecevied  PerformanceReview[] @relation("Reviewee")
  reviewsGiven     PerformanceReview[] @relation("Reviewer")
  interviewsGiven  Interview[]         @relation("Interviewer")
  onboardingTasks  OnboardingAssignment[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Shift {
  id          String     @id @default(cuid())
  name        String     @unique
  startTime   String
  endTime     String
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

model EmployeeDocument {
  id         String   @id @default(cuid())
  employeeId String
  label      String
  fileName   String
  mimeType   String
  sizeBytes  Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())

  @@index([employeeId])
}

model Department {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  employees   Employee[]
  jobPostings JobPosting[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  date        DateTime         @default(now())
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus @default(Present)
  notes       String?
  overtimeHrs Float            @default(0)
  latitude    Float?
  longitude   Float?
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date, status])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  employeeId    String
  type          String
  startDate     DateTime
  endDate       DateTime
  halfDayStart  Boolean     @default(false)
  halfDayEnd    Boolean     @default(false)
  totalDays     Float       @default(1)
  yearSplit     String?
  reason        String
  status        LeaveStatus @default(Pending)
  isCancelled   Boolean     @default(false)
  cancelledAt   DateTime?
  cancelReason  String?
  reviewComment String?
  attachmentUrl String?
  reviewedBy    String?
  reviewer      User?       @relation(fields: [reviewedBy], references: [id])
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([employeeId, status])
}

model SalaryStructure {
  id            String    @id @default(cuid())
  employeeId    String
  baseSalary    Float
  currency      String    @default("USD")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId])
}

model SalaryComponent {
  id          String        @id @default(cuid())
  employeeId  String
  type        ComponentType
  label       String
  amount      Float
  isRecurring Boolean       @default(false)
  endedAt     DateTime?
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([employeeId])
}

model AttendancePolicy {
  id                   String   @id @default(cuid())
  name                 String
  lateDeductionRule    String   @default("0")
  absenceDeductionRule String   @default("full_day")
  halfDayRule          String   @default("half_day")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Setting {
  id                        String   @id @default("singleton")
  companyName               String   @default("HR Pro")
  companyTagline            String   @default("")
  logoPath                  String   @default("")
  primaryColor              String   @default("#4756d7")
  annualLeaveEntitlement    Float    @default(21)
  sickLeaveEntitlement      Float    @default(15)
  vacationMaxDaysPerRequest Float    @default(21)
  sickMaxDaysPerRequest     Float    @default(15)
  unpaidMaxDaysPerRequest   Float    @default(30)
  currency                  String   @default("USD")
  currencySymbol            String   @default("$")
  fiscalYearStartMonth      Int      @default(1)
  workingDays               String   @default("Mon,Tue,Wed,Thu,Fri")
  weekStartsOn              String   @default("Mon")
  lateThresholdMinutes      Int      @default(15)
  standardWorkHours         Float    @default(8)
  overtimeRateMultiplier    Float    @default(1.5)
  allowPublicRegistration   Boolean  @default(false)
  registrationWhitelist     String   @default("")
  updatedAt                 DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  type      String   @default("info")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  html      String
  status    String    @default("PENDING")
  attempts  Int       @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

model PerformanceReview {
  id             String       @id @default(cuid())
  employeeId     String
  reviewerId     String?
  periodName     String
  status         ReviewStatus @default(DRAFT)
  criteriaScores String       @default("[]")
  overallScore   Float        @default(0)
  strengths      String       @default("")
  improvements   String       @default("")
  goals          String       @default("")
  reviewComment  String       @default("")
  completedAt    DateTime?
  completedBy    String?
  employee       Employee     @relation("Reviewee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer       Employee?    @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([employeeId, periodName])
  @@index([status])
  @@index([periodName])
}

model PayrollRecord {
  id               String                   @id @default(cuid())
  employeeId       String
  month            Int
  year             Int
  baseSalary       Float
  totalDeductions  Float                    @default(0)
  totalIncentives  Float                    @default(0)
  totalBonuses     Float                    @default(0)
  netSalary        Float
  status           PayrollStatus            @default(DRAFT)
  generatedAt      DateTime?
  finalizedAt      DateTime?
  paidAt           DateTime?
  generatedBy      String?
  finalizedBy      String?
  paidBy           String?
  adjustment       Float                    @default(0)
  adjustmentReason String?
  employee         Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  components       PayrollRecordComponent[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([employeeId, month, year])
  @@index([employeeId, month, year])
}

model PayrollRecordComponent {
  id              String        @id @default(cuid())
  payrollRecordId String
  type            ComponentType
  label           String
  amount          Float
  payrollRecord   PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
}

model JobPosting {
  id           String      @id @default(cuid())
  title        String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  type         JobType     @default(FULL_TIME)
  remote       Boolean     @default(false)
  location     String?
  slots        Int         @default(1)
  description  String      @default("")
  requirements String      @default("")
  salaryMin    Float?
  salaryMax    Float?
  status       JobStatus   @default(DRAFT)
  publishedAt  DateTime?
  closedAt     DateTime?
  createdBy    String?
  candidates   Candidate[]
  interviews   Interview[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([departmentId])
}

model Candidate {
  id         String          @id @default(cuid())
  name       String
  email      String
  phone      String?
  source     String          @default("")
  jobId      String?
  job        JobPosting?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status     CandidateStatus @default(NEW)
  appliedAt  DateTime        @default(now())
  resumeUrl  String?
  notes      String          @default("")
  interviews Interview[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([status])
  @@index([jobId])
  @@index([email])
}

model Interview {
  id            String          @id @default(cuid())
  candidateId   String
  candidate     Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId         String?
  job           JobPosting?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  interviewerId String?
  interviewer   Employee?       @relation("Interviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  type          InterviewType   @default(VIDEO)
  scheduledAt   DateTime
  durationMin   Int             @default(60)
  meetingLink   String?
  location      String?
  status        InterviewStatus @default(SCHEDULED)
  rating        Int?
  feedback      String?
  createdBy     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([candidateId])
  @@index([interviewerId])
  @@index([scheduledAt])
  @@index([status])
}

model OnboardingTask {
  id          String                @id @default(cuid())
  name        String
  description String                @default("")
  category    String                @default("General")
  isRequired  Boolean               @default(true)
  orderIndex  Int                   @default(0)
  active      Boolean               @default(true)
  assignments OnboardingAssignment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([active, orderIndex])
}

model OnboardingAssignment {
  id          String          @id @default(cuid())
  employeeId  String
  taskId      String
  status      OnboardingStatus @default(PENDING)
  dueDate     DateTime?
  completedBy String?
  completedAt DateTime?
  notes       String          @default("")
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task        OnboardingTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([employeeId, taskId])
  @@index([employeeId, status])
}
